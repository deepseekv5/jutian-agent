# 依赖
node_modules/

# 构建产物
dist/
release/
*.node
# vite 偶发把 chunk 吐到仓库根目录（历史遗留误提交过 index-*.js）
index-*.js

# 运行时数据（密钥/会话不入库）
*.db
*.db-shm
*.db-wal
.env
*.log

# 打包产物
*.asar
*.asar.bak

# 大体积运行时（打包时由脚本注入,不入库）
python-runtime/

# 系统/工具
.DS_Store
__pycache__/
*.tsbuildinfo
vite.config.ts.timestamp-*.mjs

# 本地工具与私人目录(不入库:宣传片工程/工具日志/遗留备份)
tools/
.workbuddy-ai/
archive/
*.bak

# 编辑器/智能体工具的工作区配置（个人环境产物，与项目无关）
.zcodeignore
.claude/
.cursor/
.aider*

# 网站构建
pages/node_modules/


# 后端构建产物（由 src/server/serve.ts 经 `npm run build:server` 生成，勿手改）
serve.cjs

# 构建产物：由 build:server 从同名 .ts 生成
src/shared/personas.cjs
src/shared/sessionCleanup.cjs
src/shared/opencodeZen.cjs
src/shared/localApi.cjs
src/shared/toolArgs.cjs
src/shared/announcement.cjs

# lint/cache 临时文件
.eslintcache

# 安卓本地版构建物：CI 构建前才下载/生成，不进仓库
# （libnode.so 62MB、Node 头文件 11MB、内置前端包 6MB——入库会让仓库暴涨）
android/app/src/local/jniLibs/
android/app/src/main/cpp/include/
android/app/src/local/assets/
android/app/build/
android/app/.cxx/
