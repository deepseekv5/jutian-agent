{
  "name": "jutian-agent",
  "version": "10.1.1",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "description": "巨天agent - 桌面 AI 智能体（终端 / 文件 / PPT / 代码）",
  "keywords": [
    "electron",
    "ai-agent",
    "desktop",
    "local-first",
    "mcp",
    "free-models",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekv5/jutian-agent.git"
  },
  "bugs": {
    "url": "https://github.com/deepseekv5/jutian-agent/issues"
  },
  "homepage": "https://github.com/deepseekv5/jutian-agent#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:server && vite build",
    "serve": "NODE_OPTIONS='--max-old-space-size=512' node serve.cjs",
    "start": "node scripts/run.js",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && bash scripts/rebuild-for-electron.sh && EDGE_TTS_DIR=\"${EDGE_TTS_DIR:-$(node scripts/edge-tts-dir.mjs)}\" electron-builder --mac",
    "electron:build:win": "vite build && EDGE_TTS_DIR=\"${EDGE_TTS_DIR:-$(node scripts/edge-tts-dir.mjs)}\" electron-builder --win",
    "electron:dist": "npm run electron:build",
    "patch": "node scripts/patch-update.mjs",
    "patch:fast": "node scripts/patch-update.mjs --no-build",
    "build:server": "esbuild src/server/serve.ts --format=cjs --platform=node --target=node18 --outfile=serve.cjs && esbuild src/shared/personas.ts --format=cjs --platform=node --target=node18 --outfile=src/shared/personas.cjs",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "build": {
    "appId": "com.jutian.agent",
    "productName": "巨天agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "serve.cjs",
      "src/shared/**/*",
      "src/server/serve.ts",
      "package.json",
      "node_modules/better-sqlite3/lib/**/*",
      "node_modules/better-sqlite3/package.json",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/@codemirror/**/*",
      "node_modules/@lezer/**/*",
      "node_modules/qrcode/**/*",
      "node_modules/react/**/*",
      "node_modules/react-dom/**/*",
      "node_modules/react-markdown/**/*",
      "node_modules/rehype-highlight/**/*",
      "node_modules/remark-gfm/**/*",
      "node_modules/pptxgenjs/**/*",
      "node_modules/zustand/**/*",
      "!**/*.map",
      "!**/*.o",
      "!**/*.obj",
      "!**/test_extension.node"
    ],
    "asarUnpack": [
      "**/better_sqlite3.node"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.plist",
      "entitlementsInherit": "electron/entitlements.plist",
      "extraResources": [
        {
          "from": "python-runtime",
          "to": "python-runtime",
          "filter": [
            "bin/**",
            "lib/python3.11/site-packages/**",
            "!**/onnxruntime/**",
            "!**/av/**",
            "!**/onnxruntime",
            "!**/av",
            "!**/pip/**",
            "!**/pip-*.dist-info/**",
            "!**/setuptools/**",
            "!**/*.pyc",
            "!**/*.pyo",
            "!**/__pycache__/**",
            "!**/tests/**",
            "!**/test_*.py"
          ]
        },
        {
          "from": "${env.EDGE_TTS_DIR}",
          "to": "edge-tts",
          "filter": [
            "**/*",
            "!__pycache__",
            "!*.pyc"
          ]
        },
        {
          "from": "src/shared/stt.py",
          "to": "stt/stt.py"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "jutian-agent-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "巨天agent"
    },
    "dmg": {
      "title": "巨天agent",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": true,
    "npmRebuild": false
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.10.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.11"
  },
  "license": "MIT"
}
