"""REEL CONFIG — 巨天agent v8.0 promotional film.

A 15-second reel on a musical grid. One scene per bar, every cut lands on a
downbeat. All palette values are traced to the brand's own tokens
(#10a37f / #34d399 / #0a0a0c) — sampled from the product's own CSS.

v8 主题:免费模型,人人可用 —— 强调免费模型面板与「AI 没有门槛」。
"""

# --- identity ---------------------------------------------------------------
BRAND = "巨天"
DOMAIN = "GITHUB.COM/DEEPSEEKV5"
PRODUCT = "AGENT"
STUDIO = "巨天工作室"
PLATFORMS = "macOS · WINDOWS"
TAGLINE = "把时间，还给做事的人。"
HERO_SUB = "少抄一段路，多做成一件事。"

# --- timeline ---------------------------------------------------------------
FPS = 30
BPM = 128
BEAT = 60.0 / BPM          # 0.46875 s
BAR = BEAT * 4             # 1.875 s
BARS = 8
DUR = BAR * BARS           # 15.000 s
NFRAMES = int(round(DUR * FPS))   # 450

OUT_W, OUT_H = 1920, 1080
W, H = 1280, 720

# --- palette ----------------------------------------------------------------
# Brand tokens traced from the product's own CSS (--accent: #10a37f family).
# v11 paper edition：纸白编辑风 —— 米白纸面、墨色正文、品牌青绿做版色。
# 语义名保持不变（WHITE=主文字色、BG1=卡面、ACCENT_LT=accent 文字色），场景零改动换装。
# 反转片：引擎是加法混合，深字画不上浅底——因此原片保持深底亮字，
# finish 管线末尾整体反色为「纸白编辑风」。ACCENT 选玫红系，反转后=品牌青绿。
INK = (8, 9, 11)
BG0 = (8, 9, 11)           # 反转后 = 纸白 (247,246,244)
BG1 = (12, 14, 18)
BG2 = (16, 19, 26)

ACCENT = (239, 92, 128)    # 反转后 = (16,163,127) 品牌青绿
ACCENT_BR = (255, 138, 160) # 反转后 = 深青绿 (0,117,95)
ACCENT_LT = (255, 170, 190) # 反转后 = 深青 (0,85,65) —— accent 文字色
ACCENT_DK = (250, 205, 218)

ALT = (216, 125, 9)
INFO = (207, 111, 23)
WARN = (10, 97, 244)
ERR = (16, 187, 187)

WHITE = (231, 231, 227)    # 反转后 = 墨字 (24,24,28)
PAPER = (247, 246, 242)    # 反转后 = 深墨封底
CARD = (0, 0, 0)           # 反转后 = 纯白
GREY = (133, 133, 141)     # 反转后 = 深灰 (122,122,114)
GREY_D = (207, 207, 213)
SLATE = (235, 227, 215)

# --- type -------------------------------------------------------------------
S_HERO = 153.0
S_WORD = 156.0
S_MONO = 96.0
S_LOGOTYPE = 62.0
S_SUB = 17.0
S_HUD = 9.5
S_TAG = 10.5

TRACK_HERO = -4.0
TRACK_WORD = -3.5
TRACK_SUB = 3.2
TRACK_HUD = 1.5

# --- HUD chrome -------------------------------------------------------------
M = 58.0
HUD_M = 27.0
HUD_TOP = 24.0
HUD_BOT = 700.0

SCENES = [
    ("01", "OPEN",        "封面"),
    ("02", "KINETIC",     "四词一拍"),
    ("03", "PERSONA",     "AI 角色"),
    ("04", "GOAL",        "目标模式"),
    ("05", "RESEARCH",    "深度调研"),
    ("06", "DATA",        "数字一版"),
    ("07", "PRIVACY",     "本地优先"),
    ("08", "SIGN OFF",    "封底"),
]

KINETIC_WORDS = ["免费", "角色", "目标", "集群"]
KINETIC_SUBS = [
    "FREE MODELS · NO KEY · NO SIGNUP",
    "AI PERSONA · MEMORY · VOICE · PAINT",
    "GOAL MODE · EVAL · AUTO CONTINUE",
    "SWARM · @ RELAY · AUTO DELIVER",
