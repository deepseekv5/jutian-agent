GAUGES = [("CPU", 0.42, ACCENT), ("MEM", 0.61, ACCENT), ("DISK", 0.73, ACCENT),
          ("NET", 0.28, ALT)]
METRICS = [("TOOLS", "39"), ("MODELS", "21"), ("ROLES", "4"), ("CLOUD", "0")]
