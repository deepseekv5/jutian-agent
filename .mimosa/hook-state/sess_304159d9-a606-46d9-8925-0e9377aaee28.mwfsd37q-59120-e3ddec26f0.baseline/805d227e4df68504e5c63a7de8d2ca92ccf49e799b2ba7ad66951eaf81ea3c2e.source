/**
 * 《更好的答案》——巨天agent 1024 特别节目
 *
 * 与《方寸》完全相反的气质：
 *   方寸 = 暖白极简、一束光、克制
 *   本片 = 深蓝鎏金、章节卡、宏大（梦之蓝广告语言）
 *
 * 节目感来自结构：冷开场 → 节目标题 → 四章（起承转合）→ 品牌收束。
 * 每章有章节卡（衬线大字 + 章号），像电视特别节目。
 *
 * 技术约定（同 promo-film）：
 *   · applyTime(ms) 是唯一时间源，无 CSS 无限动画
 *   · 随机数用固定种子，每帧一致
 *   · 2.35:1 遮幅由上下黑条实现（电影感的关键一步）
 */
const STORYBOARD = {
  total: 64000,
  // 时间轴(ms)：章节边界与旁白点位
  timeline: {
    coldOpen: [0, 7000],       // 深渊 + 光源降临
    showTitle: [7000, 12000],  // 「1024 特别节目」
    ch1: [12000, 24000],       // 起 · 一个问题
    ch2: [24000, 36000],       // 承 · 万千次尝试
    ch3: [36000, 48000],       // 转 · 它替你先行
    ch4: [48000, 56000],       // 合 · 答案有光
    brand: [56000, 64000],     // 品牌 + 主题句
  },
  narration: [
    { t: 13000, text: '每一个深夜亮着的屏幕，都是一个不肯将就的问题。' },
    { t: 25000, text: '有人用一万次尝试，换一次通过。' },
    { t: 37000, text: '而它，替你走完那九千九百九十九次。' },
    { t: 49000, text: '留下的时间，还给思考。' },
    { t: 57500, text: '巨天agent。' },
    { t: 60500, text: '更难的问题，值得更好的答案。' },
  ],
}
module.exports = STORYBOARD
