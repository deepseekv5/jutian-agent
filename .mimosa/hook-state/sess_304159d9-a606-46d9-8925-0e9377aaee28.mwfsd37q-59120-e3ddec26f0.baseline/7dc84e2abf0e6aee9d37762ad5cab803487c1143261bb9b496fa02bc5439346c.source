"""巨天agent v7.0 — 8 scenes, one per bar of the 128 BPM grid.

All Chinese text renders through the system PingFang/Hiragino face via
mg.fonts.cjk(); latin/numeric lines stay on the engine's mono face.
Palette traced from the product's own CSS: #10a37f / #34d399 / #0a0a0c.
"""
from __future__ import annotations

import numpy as np

from mg import anim as A
from mg import fonts as F
from mg.core import clip01, gauss

from . import theme as T

W, H = T.W, T.H
BEAT = T.BEAT
CX, CY = W / 2.0, H / 2.0


# --------------------------------------------------------------------------
# shared helpers
# --------------------------------------------------------------------------
def _cjk(size):
    return F.cjk(size)


def _mono(p, x, y, s, color, size=T.S_TAG, track=T.TRACK_HUD, alpha=1.0, anchor="ls"):
    return p.text(x, y, s, F.mono(size), color, track, anchor, alpha)


def plate(c, cx, cy, tint, gain=1.0, rx=640, ry=300):
    c.add += (np.asarray(tint, np.float32).reshape(1, 1, 3) * gain
              * gauss(W, H, cx, cy, rx, ry)[..., None])


def grid(p, gap_x=16, gap_y=9, alpha=0.030):
    for i in range(1, gap_x):
        p.line([(W * i / gap_x, 0), (W * i / gap_x, H)], T.ACCENT, 0.7, alpha)
    for j in range(1, gap_y):
        p.line([(0, H * j / gap_y), (W, H * j / gap_y)], T.ACCENT, 0.7, alpha * 0.8)


def reveal_cjk(p, cx, cy, text, size, color, prog, alpha=1.0, spacing=0.0):
    """Character-by-character reveal, centred on `cx`."""
    f = _cjk(size)
    n = len(text)
    widths = []
    for ch in text:
        bb = f.getbbox(ch)
        widths.append((bb[2] - bb[0]) if bb else size)
    total_w = sum(widths) + spacing * max(0, n - 1)
    x = cx - total_w / 2
    for i, ch in enumerate(text):
        a = float(np.clip(prog * n - i, 0.0, 1.0))
        if a > 0.01:
            p.text(x, cy, ch, f, color, 0.0, "lm", alpha * a)
        x += widths[i] + spacing
    return total_w


def node_box(p, x, y, w, h, radius, e, label, label_size=16, sub=None):
    """A panel node: soft green fill, then its CJK label."""
    if e <= 0.01:
        return
    p.rect(x, y, w, h, T.ACCENT, 0.10 * e, radius=radius)
    p.text(x + w / 2, y + h / 2 - (14 if sub else 0), label, _cjk(label_size),
           T.WHITE, 0.0, "mm", e)
    if sub:
        _mono(p, x + w / 2, y + h / 2 + 20, sub, T.ACCENT_LT, 9.5, 1.6, e * 0.8, "mm")


def arrow(p, x1, x2, y, e, tag=None):
    if e <= 0.01:
        return
    p.line([(x1, y), (x1 + (x2 - x1) * e, y)], T.ACCENT, 1.6, 0.9)
    if e > 0.9:
        p.dot(x2 - 4, y, 4, T.ACCENT_BR, 0.95)
    if tag and e > 0.5:
        # tags like @开发 are mixed-script: the mono face has no CJK glyphs
        p.text((x1 + x2) / 2, y - 24, tag, _cjk(10.5), T.ACCENT_BR, 1.0, "mm", 0.8)


# --------------------------------------------------------------------------
# 01 / OPEN — 品牌标题
# --------------------------------------------------------------------------
class Open:
    def render(self, c, tl, t):
        c.clear(T.INK)
        settle = A.out_expo(clip01(tl / 1.3), 3.0)
        hz = CY - 30 + 80 * settle
        breath = 1.0 + 0.04 * np.sin(t * 1.8)
        plate(c, CX, hz, (0.015, 0.065, 0.035), 1.0 * breath, 650, 180)
        p = c.pass_()
        grid(p, 16, 9, 0.028)

        # 标题逐字升起 — 巨天 in white, agent in brand green
        text = "巨天agent"
        sizes = [72, 72, 72, 72, 96, 96, 96, 96, 96]
        colors = [T.WHITE] * 4 + [T.ACCENT_BR] * 5
        widths = []
        for i, ch in enumerate(text):
            f = _cjk(sizes[i])
            bb = f.getbbox(ch)
            widths.append((bb[2] - bb[0]) if bb else sizes[i])
        x = CX - (sum(widths) + 12) / 2
        for i, ch in enumerate(text):
            e = A.out_expo(clip01((tl - 0.12 - i * 0.055) / 0.6), 4.2)
            if e > 0.01:
                p.text(x, CY - 30 + (1.0 - e) * 80, ch, _cjk(sizes[i]), colors[i],
                       0.0, "lm",
                       A.out_expo(clip01((tl - 0.12 - i * 0.055) / 0.32), 5.0))
            x += widths[i] + (6 if ord(ch) > 0x4e00 else 3)

        # 绿线从左展开
        wipe = A.out_expo(clip01((tl - 0.5) / 0.4), 4.0)
        if wipe > 0.001:
            p.line([(CX - 320, CY + 56), (CX - 320 + 640 * wipe, CY + 56)],
                   T.ACCENT, 2.4, 0.9)

        # 副标题与平台行
        if tl > 0.7:
            reveal_cjk(p, CX, CY + 100, T.TAGLINE, 17, T.WHITE,
                       A.out_expo(clip01((tl - 0.7) / 0.5), 4.0), 0.92, 2.0)
        if tl > 0.82:
            # v8 主张:AI,本该人人可用
            reveal_cjk(p, CX, CY + 130, T.HERO_SUB, 13, T.ACCENT_BR,
                       A.out_expo(clip01((tl - 0.82) / 0.45), 4.0), 0.85, 3.0)
        if tl > 1.0:
            _mono(p, CX, CY + 160, f"{T.PLATFORMS} · {T.DOMAIN}", T.ACCENT_LT, 10,
                  2.2, 0.9 * A.out_expo(clip01((tl - 1.0) / 0.5), 3.4), "ms")

        # 品牌标:圆角方块 + 三条对话线
        e0 = A.out_expo(clip01((tl - 0.04) / 0.55), 3.4)
        if e0 > 0.01:
            s2 = 56 * (0.86 + 0.14 * e0)
            x0, y0 = CX - s2 / 2, hz - 200 - s2 / 2 + (1.0 - e0) * -40
            p.rect(x0, y0, s2, s2, T.ACCENT, 1.0 * e0, radius=s2 * 0.24)
            for ly in (0.35, 0.55, 0.75):
                p.line([(x0 + s2 * 0.25, y0 + s2 * ly),
                        (x0 + s2 * 0.75, y0 + s2 * ly)], T.WHITE, 3.0, 0.9 * e0)
        c.commit()


# --------------------------------------------------------------------------
# 02 / KINETIC TYPE — 四词一拍
# --------------------------------------------------------------------------
class KineticType:
    def render(self, c, tl, t):
        b = min(len(T.KINETIC_WORDS) - 1, int(tl / BEAT))
        tb = tl - b * BEAT
        word = T.KINETIC_WORDS[b]
        sub = T.KINETIC_SUBS[b]
        c.clear(T.BG0)
        plate(c, CX, CY, (0.012, 0.045, 0.025), 1.0, 560, 200)
        p = c.pass_()
        grid(p, 24, 12, 0.022)

        # 大字从下方升起 + 品牌绿底线
        e = A.out_expo(tb / 0.28, 4.5)
        yy = CY - 20
        alpha = A.out_expo(tb / 0.18, 5.5)
        p.text(CX, yy + (1.0 - e) * 30, word, _cjk(88), T.WHITE, -2.0, "mm", alpha)
        wp = A.out_expo(tb / 0.22, 4.0)
        if wp > 0.01:
            p.line([(CX - 110, yy + 52), (CX - 110 + 220 * wp, yy + 52)],
                   T.ACCENT, 2.0, 0.8)
        _mono(p, CX, CY + 88, sub, T.ACCENT_BR, 10, 2.6,
              0.85 * A.out_expo(tb / 0.3, 4.0), "ms")
        c.commit()


# --------------------------------------------------------------------------
# 03 / TOOLS — 38 工具一览
# --------------------------------------------------------------------------
class FreeModels:
    """v8 主推场景:免费模型面板 — 21 个免费模型 · 免 key · 一键切换。"""
    MODELS = ["kilo-auto/free", "Nemotron 3 Ultra 550B", "Step 3.7 Flash",
              "Laguna S 2.1", "Nemotron 3 Nano Omni", "North Mini Code"]

    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY - 30, (0.012, 0.050, 0.028), 1.0, 620, 180)
        p = c.pass_()
        grid(p, 20, 10, 0.024)

        reveal_cjk(p, CX, 96, "免费模型", 52, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 150, "FREE MODELS · NO KEY · NO SIGNUP",
              T.ACCENT_BR, 11, 3.0, 0.75 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        # 模型卡:两列三行,逐张弹入
        cw, ch = 360, 56
        x0, y0 = CX - cw - 16, 210
        for i, name in enumerate(self.MODELS):
            row, col = divmod(i, 2)
            x, y = x0 + col * (cw + 32), y0 + row * (ch + 18)
            e = A.out_expo(clip01((tl - 0.3 - i * 0.09) / 0.35), 4.0)
            if e > 0.01:
                p.rect(x, y, cw, ch, T.ACCENT, 0.10 * e, radius=14)
                p.dot(x + 26, y + ch / 2, 4.0, T.ACCENT_BR, 0.9 * e)
                _mono(p, x + 44, y + ch / 2 + 4, name, (200, 220, 210), 13.5, 0.8, e * 0.95, "lm")

        # 底部三连:数量 / 额度 / 切换
        for i, (big, small) in enumerate([("21", "个免费模型"), ("200", "次/小时 · 每 IP"), ("1", "键切换")]):
            x = CX - 300 + i * 300
            e = A.out_expo(clip01((tl - 0.9 - i * 0.12) / 0.4), 4.0)
            if e > 0.01:
                p.text(x, H - 130, big, F.mono(40), T.ACCENT_BR, -1.0, "mm", e)
                reveal_cjk(p, x, H - 96, small, 12.5, T.WHITE,
                           A.out_expo(clip01((tl - 0.95 - i * 0.12) / 0.35), 4.0), e * 0.85, 2.0)
        c.commit()


# --------------------------------------------------------------------------
# 04 / CLUSTER — 集群协作
# --------------------------------------------------------------------------
class Cluster:
    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY - 20, (0.010, 0.045, 0.025), 1.0, 620, 200)
        p = c.pass_()
        grid(p, 16, 9, 0.026)

        reveal_cjk(p, CX, 62, "集群指挥室", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)

        nodes = [("总管", "DISPATCH"), ("开发", "BUILD"), ("测试", "VERIFY"),
                 ("交付", "SHIP")]
        tags = ["@开发", "@测试", "@交付"]
        nw, nh = 200, 110
        gap = (W - 2 * 60 - 4 * nw) / 3
        y = CY - nh / 2 - 20
        for i, (name, sub) in enumerate(nodes):
            x = 60 + i * (nw + gap)
            e = A.out_expo(clip01((tl - 0.2 - i * 0.2) / 0.4), 4.0)
            node_box(p, x, y, nw, nh, 14, e, name, 18, sub)
            if i < 3:
                arrow(p, x + nw, x + nw + gap, y + nh / 2,
                      A.out_expo(clip01((tl - 0.35 - i * 0.2) / 0.3), 4.0), tags[i])

        # 底部进度条:总管一直在收结果
        for i, (name, pct) in enumerate([("产品", 100), ("开发", 96), ("测试", 88)]):
            x = 200 + i * 280
            py = CY + nh / 2 + 80
            e = A.out_expo(clip01((tl - 0.8 - i * 0.15) / 0.35), 4.0)
            if e > 0.01:
                p.rect(x, py, 180, 4, T.ACCENT, 0.10)
                p.rect(x, py, 180 * pct / 100.0 * e, 4, T.ACCENT, 0.85)
                p.text(x + 90, py - 16, name, _cjk(11), T.WHITE, 0.0, "mm", e)
                _mono(p, x + 90, py + 20, f"{pct}%", T.ACCENT_LT, 9, 1.8, e * 0.8, "mm")
        c.commit()


# --------------------------------------------------------------------------
# 05 / COMPUTER — Computer Use
# --------------------------------------------------------------------------
class Privacy:
    """v8 场景 05:本地优先 — 数据与密钥不出这台电脑。"""

    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY - 20, (0.010, 0.040, 0.022), 1.0, 620, 200)
        p = c.pass_()
        grid(p, 16, 9, 0.024)

        reveal_cjk(p, CX, 62, "本地优先", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 100, "YOUR DATA NEVER LEAVES THIS MACHINE",
              T.ACCENT_BR, 10, 2.5, 0.75 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        # 三块:数据 / 密钥 / 遥测
        cards = [("数据", "会话 · 记忆 · 技能\n全部在 ~/.lyclaw"),
                 ("密钥", "只存本机 SQLite\n界面回显一律掩码"),
                 ("遥测", "没有账号体系\n零统计 · 零上传")]
        bw, bh = 220, 110
        for i, (title, body) in enumerate(cards):
            x = 120 + i * 280
            y = CY - 40
            e = A.out_expo(clip01((tl - 0.3 - i * 0.15) / 0.35), 4.0)
            if e > 0.01:
                node_box(p, x, y, bw, bh, 12, e, title, 17)
                for li, line in enumerate(body.split("\n")):
                    reveal_cjk(p, x + bw / 2, y + bh / 2 + 34 + li * 22, line, 11.5,
                               T.ACCENT_LT, A.out_expo(clip01((tl - 0.55 - i * 0.15 - li * 0.1) / 0.35), 4.0),
                               e * 0.8, 1.5)

        # 底部:断网也能用本地模型
        if tl > 1.0:
            reveal_cjk(p, CX, H - 70, "配 Ollama / LM Studio,断网也是完整的智能体", 13,
                       T.WHITE, A.out_expo(clip01((tl - 1.0) / 0.4), 4.0), 0.75, 2.0)
        c.commit()


# --------------------------------------------------------------------------
# 06 / REMOTE — 手机远程
# --------------------------------------------------------------------------
class Remote:
    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY - 20, (0.010, 0.040, 0.022), 1.0, 620, 200)
        p = c.pass_()
        grid(p, 16, 9, 0.024)

        reveal_cjk(p, CX, 62, "手机远程", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 100, "SCAN · PAIR · COMMAND", T.ACCENT_BR, 10, 2.5,
              0.7 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        e = A.out_expo(clip01(tl / 0.4), 4.0)
        ph_x, ph_y, ph_w, ph_h = 110, CY - 180, 180, 360
        if e > 0.01:
            p.rect(ph_x, ph_y, ph_w, ph_h, T.ACCENT, 0.10 * e, radius=20)
            p.rect(ph_x + 8, ph_y + 8, ph_w - 16, ph_h - 16, T.BG1, 0.95, radius=14)
            p.text(ph_x + ph_w / 2, ph_y + 44, "发消息", _cjk(13), T.WHITE, 0.0, "mm", e)
            _mono(p, ph_x + ph_w / 2, ph_y + 76, "→ tools / execute", T.ACCENT_LT, 9,
                  1.6, e * 0.7, "mm")
            # 气泡
            p.rect(ph_x + 24, ph_y + 120, ph_w - 48, 34, T.ACCENT, 0.16 * e, radius=9)
            p.rect(ph_x + 24, ph_y + 166, ph_w - 48, 34, (255, 255, 255), 0.06 * e, radius=9)
            p.rect(ph_x + 24, ph_y + 212, ph_w - 48, 34, (255, 255, 255), 0.06 * e, radius=9)

        e2 = A.out_expo(clip01((tl - 0.4) / 0.3), 4.0)
        if e2 > 0.01:
            x1, x2 = ph_x + ph_w, W - 400
            arrow(p, x1, x2, CY, e2)
            _mono(p, (x1 + x2) / 2, CY - 26, "PAIRING CODE", T.ACCENT_LT, 9, 2.0,
                  0.7 * e2, "mm")

        e3 = A.out_expo(clip01((tl - 0.6) / 0.4), 4.0)
        if e3 > 0.01:
            cx, cy, cw, ch = W - 390, CY - 160, 300, 320
            p.rect(cx, cy, cw, ch, T.ACCENT, 0.10 * e3, radius=14)
            p.rect(cx + 8, cy + 8, cw - 16, ch - 16, T.BG1, 0.95, radius=10)
            p.text(cx + cw / 2, cy + 52, "巨天agent", _cjk(15), T.WHITE, 0.0, "mm", e3)
            _mono(p, cx + cw / 2, cy + 88, "38 tools · swarm · diff", T.ACCENT_LT, 9,
                  1.6, e3 * 0.8, "mm")
            p.rect(cx + 24, cy + 120, cw - 48, 34, T.ACCENT, 0.14 * e3, radius=9)
            p.rect(cx + 24, cy + 166, cw - 48, 34, (255, 255, 255), 0.06 * e3, radius=9)
            p.rect(cx + 24, cy + 212, cw - 48, 34, (255, 255, 255), 0.06 * e3, radius=9)
            # 输入条
            p.rect(cx + 24, cy + ch - 52, cw - 48, 30, (255, 255, 255), 0.08 * e3, radius=8)
            _mono(p, cx + 38, cy + ch - 32, "run ↵", T.GREY, 9, 1.4, 0.6 * e3, "lm")
        c.commit()


# --------------------------------------------------------------------------
# 03b / PERSONA — AI 角色：有记忆 · 能说话 · 会画画（v10 新增）
# --------------------------------------------------------------------------
class Persona:
    """v10 主打场景:角色卡 + 聊天气泡 + 三能力 chip。"""

    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY, (0.014, 0.048, 0.028), 1.0, 680, 220)
        p = c.pass_()
        grid(p, 20, 10, 0.024)

        reveal_cjk(p, CX, 62, "AI 角色", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 100, "MEMORY · VOICE · PAINT · FREE", T.ACCENT_BR, 10, 2.5,
              0.7 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        # 左：角色卡（头像圈 + 名字 + 标签 + 三能力）
        e0 = A.out_expo(clip01(tl / 0.45), 4.0)
        if e0 > 0.01:
            kx, ky, kw, kh = 150, CY - 160, 330, 330
            p.rect(kx, ky, kw, kh, T.ACCENT, 0.10 * e0, radius=18)
            p.rect(kx + 6, ky + 6, kw - 12, kh - 12, T.BG1, 0.95, radius=14)
            # 渐变感头像圈:双圆叠色
            acx, acy = kx + kw / 2, ky + 74
            p.rect(acx - 34, acy - 34, 68, 68, (52, 211, 153), 0.85 * e0, radius=34)
            p.rect(acx - 22, acy - 22, 44, 44, (14, 165, 233), 0.85 * e0, radius=22)
            p.text(acx, acy, "巨", _cjk(20), (10, 20, 16), 0.0, "mm", 0.95 * e0)
            p.text(kx + kw / 2, ky + 152, "小巨", _cjk(17), T.WHITE, 0.0, "mm", e0)
            p.text(kx + kw / 2, ky + 180, "温和耐心的日常陪伴", _cjk(11), T.GREY, 0.0, "mm", 0.8 * e0)
            # 三能力 chip
            chips = [("记忆", 0.55), ("朗读", 0.70), ("画画", 0.85)]
            cw = 84
            for i, (label, prog) in enumerate(chips):
                e = A.out_expo(clip01((tl - prog) / 0.3), 4.0)
                if e > 0.01:
                    x = kx + 24 + i * (cw + 12)
                    p.rect(x, ky + 218, cw, 34, T.ACCENT, 0.14 * e, radius=9)
                    p.text(x + cw / 2, ky + 235, label, _cjk(12), T.ACCENT_LT, 0.0, "mm", e)

        # 右：对话卡 + 气泡依次浮现
        e1 = A.out_expo(clip01((tl - 0.35) / 0.45), 4.0)
        if e1 > 0.01:
            dx, dy, dw, dh = 560, CY - 180, 1230, 380
            p.rect(dx, dy, dw, dh, T.ACCENT, 0.18 * e1, radius=18)
            p.rect(dx + 6, dy + 6, dw - 12, dh - 12, T.BG1, 0.95, radius=14)
            # 用户气泡（右）
            e = A.out_expo(clip01((tl - 0.55) / 0.3), 4.0)
            if e > 0.01:
                bx, by, bw, bh = dx + dw - 560, dy + 44, 520, 52
                p.rect(bx, by, bw, bh, T.ACCENT, 0.28 * e, radius=14)
                p.text(bx + bw - 20, by + bh / 2, "记住我习惯深夜工作", _cjk(14), T.WHITE, 0.0, "rm", e)
            # 角色气泡（左）+ AI 生成标识
            e = A.out_expo(clip01((tl - 0.85) / 0.3), 4.0)
            if e > 0.01:
                bx, by, bw, bh = dx + 28, dy + 112, 700, 52
                p.rect(bx, by, bw, bh, (255, 255, 255), 0.08 * e, radius=14)
                p.text(bx + 20, by + bh / 2, "记住了，凌晨两点前记得休息。", _cjk(14), T.WHITE, 0.0, "lm", e)
                p.rect(bx, by + 60, 64, 20, T.ACCENT, 0.14 * e, radius=6)
                p.text(bx + 32, by + 70, "AI 生成", _cjk(9), T.ACCENT_LT, 0.0, "mm", 0.9 * e)
                # 朗读波形
                for i, hgt in enumerate((10, 18, 26, 18, 10)):
                    p.rect(bx + 84 + i * 10, by + 60 + 10 - hgt / 2, 4, hgt * e,
                           T.ACCENT, 0.8 * e)
            # 画作气泡（图片缩略卡）
            e = A.out_expo(clip01((tl - 1.15) / 0.35), 4.0)
            if e > 0.01:
                bx, by, bw, bh = dx + 28, dy + 200, 150, 150
                p.rect(bx, by, bw, bh, T.ACCENT, 0.30 * e, radius=12)
                # 画中山(极简)
                p.rect(bx + bw * 0.2, by + bh * 0.55, bw * 0.6, bh * 0.32, (52, 211, 153), 0.55 * e, radius=8)
                p.rect(bx + bw * 0.12, by + bh * 0.72, bw * 0.76, bh * 0.2, (14, 165, 233), 0.45 * e, radius=8)
                _mono(p, bx + bw / 2, by + bh + 18, "PAINT · 1024x1024", T.ACCENT_LT, 9, 1.6,
                      0.7 * e, "mm")
        c.commit()


# --------------------------------------------------------------------------
# 03c / GOAL MODE — 一个目标，自动续跑（v10 新增）
# --------------------------------------------------------------------------
class GoalMode:
    """v10 场景:目标卡 + 评估进度动画。"""

    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY, (0.012, 0.050, 0.026), 1.0, 700, 220)
        p = c.pass_()
        grid(p, 20, 10, 0.024)

        reveal_cjk(p, CX, 62, "目标模式", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 100, "ONE GOAL · EVAL EVERY ROUND · AUTO CONTINUE", T.ACCENT_BR, 10, 2.5,
              0.7 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        e0 = A.out_expo(clip01((tl - 0.35) / 0.5), 4.0)
        if e0 > 0.01:
            gx, gy, gw, gh = CX - 430, CY - 90, 860, 260
            p.rect(gx, gy, gw, gh, T.ACCENT, 0.10 * e0, radius=18)
            p.rect(gx + 6, gy + 6, gw - 12, gh - 12, T.BG1, 0.95, radius=14)
            # 头行:◎ 目标模式 [进行中]
            p.rect(gx + 28, gy + 34, 14, 14, T.ACCENT, 0.9 * e0, radius=7)
            p.rect(gx + 32, gy + 38, 6, 6, T.BG1, 0.9 * e0, radius=3)
            p.text(gx + 56, gy + 44, "目标模式", _cjk(14), T.WHITE, 0.0, "lm", e0)
            badge_w = 86
            p.rect(gx + gw - 28 - badge_w, gy + 28, badge_w, 26, T.ACCENT, 0.16 * e0, radius=13)
            p.text(gx + gw - 28 - badge_w / 2, gy + 41, "进行中", _cjk(11), T.ACCENT_LT, 0.0, "mm", e0)
            # 目标标题
            p.text(gx + 28, gy + 92, "官网首页交付并构建通过", _cjk(22), T.WHITE, 0.0, "lm", e0)
            # 进度条:33% → 100% 随时间推进
            prog = A.out_expo(clip01((tl - 0.7) / 0.9), 3.0)
            pct = 0.33 + 0.67 * prog
            p.rect(gx + 28, gy + 132, gw - 56, 6, T.ACCENT, 0.12 * e0)
            p.rect(gx + 28, gy + 132, (gw - 56) * pct, 6, T.ACCENT, 0.9 * e0)
            _mono(p, gx + gw - 28, gy + 136, f"R{2 if prog < 0.9 else 3}/3", T.ACCENT_LT, 10, 1.6,
                  0.8 * e0, "rs")
            # 评估行（中文走 cjk 字形，mono 无中文）
            e2 = A.out_expo(clip01((tl - 1.0) / 0.4), 4.0)
            if e2 > 0.01:
                p.text(gx + 28, gy + 172, "已评估 2 次 · 已运行 6 分钟", _cjk(12), T.GREY,
                       1.0, "lm", 0.8 * e2)
                p.text(gx + 28, gy + 204, "最近检查：构建通过，还差文案与双语切换", _cjk(12),
                       T.ACCENT_LT, 0.0, "lm", 0.9 * e2)
            # 底注
            _mono(p, gx + gw / 2, gy + gh + 28, "INDEPENDENT EVALUATOR · AUTO CONTINUE (MAX 3)",
                  T.GREY, 9, 2.0, 0.55 * e0, "mm")
        c.commit()


# --------------------------------------------------------------------------
# 05b / RESEARCH — 深度调研：问题 → 来源 → 带引用报告（v11 paper 新增）
# --------------------------------------------------------------------------
class Research:
    """调研卡：问题行、来源核对列表、带 [n] 引用的报告正文。"""

    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY, (0.94, 0.94, 0.90), 0.55, 680, 230)
        p = c.pass_()
        grid(p, 20, 10, 0.035)

        reveal_cjk(p, CX, 62, "深度调研", 34, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.95)
        _mono(p, CX, 100, "QUERY · SEARCH · READ · CITE", T.ACCENT, 10, 2.5,
              0.75 * A.out_expo(clip01((tl - 0.3) / 0.4), 4.0), "ms")

        e0 = A.out_expo(clip01((tl - 0.35) / 0.5), 4.0)
        if e0 > 0.01:
            gx, gy, gw, gh = CX - 440, CY - 80, 880, 280
            p.rect(gx, gy, gw, gh, T.ACCENT, 0.22 * e0, radius=18)
            p.rect(gx + 6, gy + 6, gw - 12, gh - 12, T.CARD, 0.98 * e0, radius=14)
            # 问题行
            p.text(gx + 28, gy + 46, "调研问题", _cjk(11), T.GREY, 0.0, "lm", 0.8 * e0)
            p.text(gx + 110, gy + 46, "国产大模型开源生态现状", _cjk(15), T.WHITE, 0.0, "lm", e0)
            # 来源核对列表
            srcs = [("deepseek.com", True), ("arxiv.org", True), ("gov.cn 政策页", True), ("bilibili.com", False)]
            for i, (host, ok) in enumerate(srcs):
                e = A.out_expo(clip01((tl - 0.6 - i * 0.12) / 0.25), 4.0)
                if e > 0.01:
                    y = gy + 84 + i * 26
                    if ok:
                        p.text(gx + 34, y, "✓", F.mono(11), T.ACCENT, 0.0, "lm", e)
                    else:
                        p.text(gx + 34, y, "×", F.mono(11), T.GREY, 0.0, "lm", e * 0.7)
                    _mono(p, gx + 56, y, host, T.WHITE if ok else T.GREY, 10, 1.4,
                          (0.9 if ok else 0.5) * e, "lm")
                    if ok:
                        _mono(p, gx + gw - 34, y, "CITED", T.ACCENT, 9, 2.0, 0.75 * e, "rs")
                    else:
                        _mono(p, gx + gw - 34, y, "FILTERED", T.GREY, 9, 2.0, 0.55 * e, "rs")
            # 报告行（带引用）
            e2 = A.out_expo(clip01((tl - 1.25) / 0.35), 4.0)
            if e2 > 0.01:
                p.rect(gx + 24, gy + gh - 66, gw - 48, 2, T.ACCENT, 0.30 * e2)
                p.text(gx + 28, gy + gh - 36, "结论先行，事实带 [1][2] 来源编号 —— 编造率为零。", _cjk(13),
                       T.WHITE, 0.0, "lm", e2)
            _mono(p, gx + gw / 2, gy + gh + 28, "FREE MODELS ONLY · CROSS-CHECKED", T.GREY, 9, 2.0,
                  0.6 * e0, "mm")
        c.commit()


# --------------------------------------------------------------------------
# 07 / DATA — 数字滚动
# --------------------------------------------------------------------------
class Data:
    def render(self, c, tl, t):
        c.clear(T.BG0)
        plate(c, CX, CY, (0.010, 0.045, 0.025), 1.0, 700, 250)
        p = c.pass_()

        reveal_cjk(p, CX, 90, "不是功能列表，是能力。", 26, T.WHITE,
                   A.out_expo(clip01(tl / 0.5), 4.0), 0.92)

        # v10:门槛向指标 — 角色 / 自动续跑 / 免费模型 / 工具
        data = [("4", "预置 AI 角色"), ("3", "轮目标自动续跑"),
                ("21", "免费模型"), ("39", "内置工具")]
        for i, (num, label) in enumerate(data):
            x = 80 + i * 280 + 140
            y = CY + 20
            e = A.out_expo(clip01((tl - 0.2 - i * 0.1) / 0.5), 4.5)
            if e > 0.01:
                p_e = A.out_expo(clip01((tl - 0.2 - i * 0.1) / 0.8), 3.0)
                val = int(float(num) * p_e)
                p.text(x, y, str(val), F.mono(72), T.WHITE, -2.0, "mm", e)
                p.text(x, y + 44, label, _cjk(13), T.ACCENT_LT, 2.0, "mm", e * 0.8)
                p.rect(x - 80, y - 66, 160, 2, T.ACCENT, 0.35 * e)
        c.commit()


# --------------------------------------------------------------------------
# 08 / SIGN OFF — 品牌落版
# --------------------------------------------------------------------------
class SignOff:
    def render(self, c, tl, t):
        c.clear(T.PAPER)
        hz = CY - 40
        breath = 1.0 + 0.03 * np.sin(t * 1.5)
        plate(c, CX, hz, (0.014, 0.060, 0.032), 1.0 * breath, 700, 200)
        p = c.pass_()
        grid(p, 16, 9, 0.024)

        e = A.out_expo(clip01(tl / 0.7), 4.0)
        reveal_cjk(p, CX, hz - 30, "AI，本该人人可用。", 44, T.CARD, e, 0.95, -1.0)

        if tl > 0.5:
            e2 = A.out_expo(clip01((tl - 0.5) / 0.4), 4.0)
            p.text(CX, hz + 48, "巨天agent", _cjk(20), T.ACCENT, 1.0, "mm", e2)
            # 工作室名是 CJK,PingFang 一张脸排完中英文
            p.text(CX, hz + 84, "巨天工作室 · MIT · LOCAL FIRST", _cjk(11),
                   T.ACCENT_LT, 2.2, "ms", 0.7 * e2)

        if tl > 0.7:
            e3 = A.out_expo(clip01((tl - 0.7) / 0.4), 4.0)
            s2 = 48 * e3
            p.rect(CX - s2 / 2, hz + 112, s2, s2, T.ACCENT, 0.9 * e3, radius=s2 * 0.22)
            if s2 > 20:
                for ly in (0.35, 0.55, 0.75):
                    p.line([(CX - s2 * 0.25, hz + 112 + s2 * ly),
                            (CX + s2 * 0.25, hz + 112 + s2 * ly)], T.WHITE,
                           2.4, 0.9 * e3)
        c.commit()


# v10 重排:开场 → 大字(角色/目标) → 角色演示 → 目标演示 → 免费模型 → 指标 → 隐私 → 落版
SCENES = [Open, KineticType, Persona, GoalMode, Research, Data, Privacy, SignOff]
