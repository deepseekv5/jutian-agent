export const PRIVACY_POLICY: LegalDoc = {
  title: '隐私政策',
  updated: LEGAL_VERSION,
  intro: '巨天agent 以本地优先为设计原则：业务数据全部存储在你的设备上，开发者不收集、不上传、无法访问你的数据。本政策逐项说明本软件处理哪些信息、如何处理、存放在哪里、什么情况下会经第三方，以及你对这些信息有哪些控制权。个人信息处理者为你自己（数据全部存储于你的设备）。',
