#!/usr/bin/env python3
"""巨天agent v8 B站封面渲染 — 1920×1200(16:10,B站推荐比例)。

液态玻璃风格:浅色纸面 + 薄荷/薰衣草/暖沙三色场 + 玻璃卡片。
主张:科技不是高高在上,而是服务于人民。
钩子:免费模型(真实:21 个免 key 免费档,0 元,每 IP 200 次/时)。
"""
import math
import numpy as np
from PIL import Image, ImageDraw, ImageFilter, ImageFont

W, H = 1920, 1200
GREEN = (16, 163, 127)
GREEN_BR = (47, 158, 110)
GREEN_DEEP = (39, 79, 71)
INK = (36, 57, 54)
INK2 = (81, 103, 95)
INK3 = (125, 143, 136)
PINGFANG = "/System/Library/Fonts/Hiragino Sans GB.ttc"

def cjk(size, weight=600):
    return ImageFont.truetype(PINGFANG, size, index=0)

def mono(size):
    for p in ["/System/Library/Fonts/Menlo.ttc", "/System/Library/Fonts/SFMono-Regular.otf"]:
        try:
            return ImageFont.truetype(p, size)
        except Exception:
            continue
    return ImageFont.truetype(PINGFANG, size)

def text_w(draw, s, f):
    b = draw.textbbox((0, 0), s, font=f)
    return b[2] - b[0], b[3] - b[1]

def draw_text(draw, cx, y, s, f, color, anchor="mm", spacing=0):
    """anchor: mm/mt/ms 水平居中, 也可 (x,anchor)"""
    w, h = text_w(draw, s, f)
    x = cx - w / 2
    draw.text((x, y), s, font=f, fill=color)
    return w

# ─── 背景:纸面 + 三色场 ───
yy = np.linspace(0, 1, H)[:, None]
base = (247 + (255 - 247) * yy) * np.ones((1, W))
img_arr = np.repeat(base[:, :, None], 3, axis=2).astype(np.float32)

def blob(cx, cy, rx, ry, color, gain):
    global img_arr
    x = np.arange(W)[None, :]
    y = np.arange(H)[:, None]
    d = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2
    m = np.exp(-d * 1.6) * gain
    img_arr += m[:, :, None] * np.array(color, np.float32)

blob(280, 180, 760, 520, (182, 220, 214), 0.55)   # 薄荷
blob(1700, 260, 700, 500, (199, 185, 219), 0.42)  # 薰衣草
blob(1150, 1120, 900, 480, (229, 214, 161), 0.34) # 暖沙
blob(960, 540, 1200, 700, (255, 255, 255), 0.22)  # 中央提亮

img = Image.fromarray(np.clip(img_arr, 0, 255).astype(np.uint8), "RGB")

# ─── 玻璃卡片工具 ───
def glass_card(size, radius=28, tint=(255, 255, 255), alpha=110, shadow=True):
    w, h = size
    card = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    d = ImageDraw.Draw(card)
    d.rounded_rectangle([0, 0, w - 1, h - 1], radius=radius, fill=tint + (alpha,),
                        outline=(255, 255, 255, 150), width=2)
    if shadow:
        sh = Image.new("RGBA", (w + 60, h + 60), (0, 0, 0, 0))
        ImageDraw.Draw(sh).rounded_rectangle([30, 30, w + 29, h + 29], radius=radius, fill=(33, 53, 82, 55))
        sh = sh.filter(ImageFilter.GaussianBlur(18))
        return sh, card
    return None, card

def paste_card(x, y, card, shadow=None):
    if shadow is not None:
        img.paste(shadow, (x - 30, y - 26), shadow)
    img.paste(card, (x, y), card)

d = ImageDraw.Draw(img)

# ─── 顶部:品牌 ───
mark_size = 76
sh, card = glass_card((mark_size, mark_size), radius=22, tint=GREEN, alpha=255)
paste_card(120, 84, card, sh)
md = ImageDraw.Draw(card)
for ly in (0.34, 0.52, 0.70):
    md.line([(mark_size * 0.26, mark_size * ly), (mark_size * 0.74, mark_size * ly)],
            fill=(255, 255, 255, 235), width=5)
d.text((120 + mark_size + 26, 84 + 8), "巨天agent", font=cjk(46), fill=INK)
# v8 pill:按品牌文字实际宽度定位,避免重叠
brand_w, _ = text_w(d, "巨天agent", cjk(46))
pill_x = 120 + mark_size + 26 + brand_w + 24
pw = 132
sh, card = glass_card((pw, 52), radius=26, tint=GREEN, alpha=232)
paste_card(pill_x, 96, card, sh)
pd = ImageDraw.Draw(card)
t = "v8.0.0"
w, _ = text_w(pd, t, mono(26))
pd.text(((pw - w) / 2, 11), t, font=mono(26), fill=(255, 255, 255, 255))
# 右上:三连 pill
tags = ["开源", "本地优先", "MIT"]
tx = W - 120
for t in reversed(tags):
    f = cjk(26)
    w, _ = text_w(d, t, f)
    pw = w + 44
    sh, card = glass_card((pw, 52), radius=26)
    paste_card(tx - pw, 96, card, sh)
    ImageDraw.Draw(card).text((22, 10), t, font=f, fill=GREEN_DEEP)
    tx -= pw + 16

# ─── 主钩子 ───
kicker = "桌 面 AI 工 作 台"
f_k = cjk(30, 500)
w, _ = text_w(d, kicker, f_k)
d.text(((W - w) / 2, 250), kicker, font=f_k, fill=GREEN_BR)

h1 = "AI,免费了。"
f_h1 = cjk(168, 700)
w, _ = text_w(d, h1, f_h1)
d.text(((W - w) / 2, 300), h1, font=f_h1, fill=INK)

sub = "21 个免费模型 · 免注册一键切换 · 不花一分钱"
f_sub = cjk(50)
w, _ = text_w(d, sub, f_sub)
d.text(((W - w) / 2, 512), sub, font=f_sub, fill=INK2)

# ─── 三张模型玻璃卡 ───
models = [("kilo-auto/free", "自动路由 · 永远挑最快的免费活源"),
          ("Nemotron 3 Ultra", "550B MoE · 100 万上下文"),
          ("Step 3.7 Flash", "多模态识图 · 262K 上下文")]
cw, chh, gap = 460, 150, 36
total = cw * 3 + gap * 2
x0 = (W - total) / 2
for i, (name, desc) in enumerate(models):
    x = int(x0 + i * (cw + gap))
    sh, card = glass_card((cw, chh), radius=26)
    paste_card(x, 640, card, sh)
    cd = ImageDraw.Draw(card)
    cd.ellipse((36, 62, 52, 78), fill=GREEN_BR + (255,))
    f_n = cjk(34, 600)
    f_dsc = cjk(24, 400)
    cd.text((70, 34), name, font=f_n, fill=INK)
    cd.text((70, 88), desc, font=f_dsc, fill=INK3)

# ─── 绿色大 pill:0 元 · 免密钥 · 200 次/时 ───
pill = "0 元 · 免密钥 · 每 IP 200 次/小时"
f_p = cjk(40, 600)
w, _ = text_w(d, pill, f_p)
pw = int(w + 96)
sh, card = glass_card((pw, 88), radius=44, tint=GREEN, alpha=240)
paste_card(int((W - pw) / 2), 850, card, sh)
ImageDraw.Draw(card).text((48, 20), pill, font=f_p, fill=(255, 255, 255, 255))

# ─── 底部:主张 ───
motto = "科技不是高高在上,而是服务于人民。"
f_m = cjk(38, 500)
w, _ = text_w(d, motto, f_m)
d.text(((W - w) / 2, 1010), motto, font=f_m, fill=GREEN_DEEP)
foot = "macOS · Windows · GitHub 开源 · 数据只存在你的电脑上"
f_f = cjk(26, 400)
w, _ = text_w(d, foot, f_f)
d.text(((W - w) / 2, 1076), foot, font=f_f, fill=INK3)

out = "/Users/zeroneil/Desktop/巨天agent-B站封面-v8.png"
img.save(out, "PNG")
print("已生成:", out, f"({W}×{H})")
