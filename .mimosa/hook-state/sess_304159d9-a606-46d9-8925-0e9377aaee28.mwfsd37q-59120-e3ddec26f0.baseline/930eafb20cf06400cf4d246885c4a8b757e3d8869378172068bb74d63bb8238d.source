"""OpenCode Zen Free — 六个免 key 免费模型的真实规格。

数据取自上游权威 catalog（https://models.opencode.ai/api.json），
逐字段核对，不做任何美化或编造。六轴雷达的每一维都是真值：

  ctx  上下文窗口    context
  out  最大输出      output
  mm   多模态输入数  modalities.input（文本外还能吃几种）
  eff  推理档位      reasoning_options.effort 的档数
  att  附件/文件     attachment
  rel  新近度        release_date（按月归一）

归一化用绝对对数刻度而非跨模型 min-max：Big Pickle 不是"零能力"，
只是上下文最小的紧凑档；用 min-max 会把它压成中心一个点，既难看又误导。
"""
from __future__ import annotations

# 六轴顺序（雷达图顶点按此排列，从正上方顺时针）
AXES = ["ctx", "out", "mm", "eff", "att", "rel"]
AXIS_LABELS = {
    "ctx": "上下文",
    "out": "输出",
    "mm": "多模态",
    "eff": "推理档",
    "att": "附件",
    "rel": "新近度",
}

# axes 为 0..1 归一值；其余字段是给人看的原始真值
MODELS = [
