# 汇总真实数字（片尾用）
TOTAL = len(MODELS)
MAX_CTX = max(m["ctx"] for m in MODELS)          # 1,048,576
MAX_OUT = max(m["out"] for m in MODELS)          # 524,288
MULTIMODAL = sum(1 for m in MODELS if m["mm"] > 1)  # 吃图像/视频的有几个
REASONING = sum(1 for m in MODELS if m["eff"] > 0)  # 可调推理强度的有几个


def fmt_ctx(n: int) -> str:
    """把 token 数缩写成 200K / 1M 这类可读串。"""
    if n >= 1_000_000:
        v = n / 1_000_000
        return f"{v:.0f}M" if abs(v - round(v)) < 0.05 else f"{v:.2f}M"
    return f"{round(n / 1000)}K"
