    {
        "id": "nemotron-3.5-lightning-free", "name": "Nemotron 3.5 Lightning",
        "tag": "超长输出",
        "desc": "输出拉满 262K，闪电档",
        "ctx": 262144, "out": 262144, "mm": 1, "mm_list": ["text"], "eff": 0, "att": False,
        "release": "2026-08-11",
        "axes": {"ctx": 0.21, "out": 0.75, "mm": 0.00, "eff": 0.00, "att": 0.00, "rel": 0.86},
    },
    {
        "id": "step-5-preview-free", "name": "Step 5 Preview",
        "tag": "百万上下文 · 三档推理",
        "desc": "1M 窗口，可调推理强度",
        "ctx": 1000000, "out": 65536, "mm": 3, "mm_list": ["text", "image", "video"], "eff": 3, "att": True,
        "release": "2026-09-16",
        "axes": {"ctx": 0.95, "out": 0.27, "mm": 0.67, "eff": 0.60, "att": 1.00, "rel": 0.96},
