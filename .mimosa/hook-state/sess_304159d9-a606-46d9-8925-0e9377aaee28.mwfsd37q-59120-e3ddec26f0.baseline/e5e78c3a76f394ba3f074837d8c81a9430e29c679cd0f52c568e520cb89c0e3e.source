"""v4 主题：OpenCode Zen Free 免费模型宣传片。

沿用引擎的「纸白编辑风」反色管线：原片在深底上用玫红系绘制，
finish 末尾整体反色 → 纸白底 + 墨字 + 品牌青绿。语义名保持不变，
所以场景代码里的 ACCENT 实际会显示成品牌青绿 (#10a37f)。

时长：10 小节 × 1.875s = 18.75s @ 128 BPM。
"""
from __future__ import annotations

FPS = 30
BPM = 128
BEAT = 60.0 / BPM          # 0.46875 s
BAR = BEAT * 4             # 1.875 s
BARS = 10
DUR = BAR * BARS           # 18.75 s
NFRAMES = int(round(DUR * FPS))

OUT_W, OUT_H = 1920, 1080
W, H = 1280, 720

# --- palette（深底玫红，反色后=纸白青绿）---
INK = (8, 9, 11)
BG0 = (8, 9, 11)
BG1 = (12, 14, 18)
BG2 = (16, 19, 26)

ACCENT = (239, 92, 128)     # 反色后 = 品牌青绿 (16,163,127)
ACCENT_BR = (255, 138, 160)  # 反色后 = 深青绿
ACCENT_LT = (255, 170, 190)  # 反色后 = 深青（accent 文字色）
ACCENT_DK = (250, 205, 218)

ALT = (216, 125, 9)          # 反色后 = 蓝调
INFO = (207, 111, 23)
WARN = (10, 97, 244)
ERR = (16, 187, 187)

WHITE = (231, 231, 227)      # 反色后 = 墨字
PAPER = (247, 246, 242)
CARD = (0, 0, 0)             # 反色后 = 纯白
GREY = (133, 133, 141)
GREY_D = (207, 207, 213)
SLATE = (235, 227, 215)

# --- type ---
S_HERO = 153.0
S_WORD = 156.0
S_MONO = 96.0
S_LOGOTYPE = 62.0
S_SUB = 17.0
S_HUD = 9.5
S_TAG = 10.5

TRACK_HERO = -4.0
TRACK_SUB = 3.2
TRACK_HUD = 1.5

# --- HUD chrome ---
M = 58.0
HUD_M = 27.0
HUD_TOP = 24.0
HUD_BOT = 700.0

DOMAIN = "OPENCODE ZEN FREE"
STUDIO = "巨天agent"

# 十小节分镜（HUD 右上角显示）
SCENES = [
    ("01", "OPEN",       "封面"),
    ("02", "BIG PICKLE", "紧凑纯文本"),
    ("03", "MIMO",       "全模态"),
    ("04", "NEMOTRON",   "超长输出"),
    ("05", "STEP 5",     "百万上下文"),
    ("06", "LONGCAT",    "图文长文"),
    ("07", "SPACE BUNNY", "全能旗舰"),
    ("08", "OVERLAY",    "六形叠影"),
    ("09", "METRICS",    "数字一版"),
    ("10", "SIGN OFF",   "封底"),
]
