# 封面渲染 —— 1920×1200（B 站推荐 16:10）
# 设计取向与 v3 宣传片一致：浅色液态玻璃 + 真实产品形态 + 大字主张。
# 钩子写在封面上：目标不是"我们有 42 个工具"，而是"你不用再自己动手"。
import math
from PIL import Image, ImageDraw, ImageFilter, ImageFont

W, H = 1920, 1200
MINT = (16, 163, 127)
LAV = (124, 58, 237)
SAND = (245, 158, 11)
INK = (17, 24, 32)
INK2 = (74, 85, 96)
INK3 = (138, 148, 156)
PAPER = (250, 250, 251)

def cjk(size, weight=600):
    return ImageFont.truetype("/System/Library/Fonts/Hiragino Sans GB.ttc", size, index=0)

def mono(size):
    for p in ["/System/Library/Fonts/Menlo.ttc"]:
        try:
            return ImageFont.truetype(p, size)
        except Exception:
            pass
    return cjk(size)

def text_w(d, s, f):
    b = d.textbbox((0, 0), s, font=f)
    return b[2] - b[0]

def text_h(d, s, f):
    b = d.textbbox((0, 0), s, font=f)
    return b[3] - b[1]

def centered(d, cx, y, s, f, fill):
    d.text((cx - text_w(d, s, f) / 2, y), s, font=f, fill=fill)

def centered_h(d, cx, y, s, f, fill):
    # 垂直居中于 y
    th = text_h(d, s, f)
    d.text((cx - text_w(d, s, f) / 2, y - th / 2 - d.textbbox((0,0), s, font=f)[1]), s, font=f, fill=fill)

def roundrect(d, box, r, fill=None, outline=None, width=1):
    d.rounded_rectangle(box, radius=r, fill=fill, outline=outline, width=width)

def glow(base, cx, cy, r, color, alpha):
    layer = Image.new("RGBA", base.size, (0, 0, 0, 0))
    ld = ImageDraw.Draw(layer)
    ld.ellipse([cx - r, cy - r, cx + r, cy + r], fill=color + (alpha,))
    layer = layer.filter(ImageFilter.GaussianBlur(r * 0.55))
    base.alpha_composite(layer)

def glass(base, box, r=22, alpha=190):
    # 磨砂玻璃片：白色半透明 + 亮边
    layer = Image.new("RGBA", base.size, (0, 0, 0, 0))
    ld = ImageDraw.Draw(layer)
    ld.rounded_rectangle(box, radius=r, fill=(255, 255, 255, alpha))
    ld.rounded_rectangle(box, radius=r, outline=(255, 255, 255, 235), width=2)
    base.alpha_composite(layer)

def render(cover_title, cover_sub, out):
    img = Image.new("RGBA", (W, H), PAPER + (255,))
    d = ImageDraw.Draw(img)

    # 三色场：薄荷 / 薰衣草 / 暖沙
    glow(img, 240, 180, 460, MINT, 46)
    glow(img, W - 260, 250, 470, LAV, 34)
    glow(img, W / 2, H - 120, 520, SAND, 26)

    # 顶部品牌行
    f_brand = cjk(34, 600)
    d.text((96, 78), cover_title_brand(), font=f_brand, fill=INK)
    tag = "编程智能体 · v11.6.0"
    f_tag = mono(24)
    d.text((W - 96 - text_w(d, tag, f_tag), 84), tag, font=f_tag, fill=INK3)

    # 主张（两行，第二行用品牌绿）
    f_h1 = cjk(116, 700)
    line1 = cover_title[0]
    line2 = cover_title[1]
    centered(d, W / 2, 250, line1, f_h1, INK)
    centered(d, W / 2, 250 + 138, line2, f_h1, MINT)

    f_sub = cjk(40, 400)
    centered(d, W / 2, 560, cover_sub, f_sub, INK2)

    # 主视觉：仿应用三栏窗口（缩略），把"真实产品"放封面
    win_x0, win_y0 = 300, 660
    win_w, win_h = W - 600, 380
    glass(img, (win_x0, win_y0, win_x0 + win_w, win_y0 + win_h), r=26, alpha=205)

    # 左栏
    lw = int(win_w * 0.22)
    d.rectangle([win_x0 + 18, win_y0 + 26, win_x0 + lw - 10, win_y0 + win_h - 26], fill=(255, 255, 255, 170))
    for i, lab in enumerate(["新对话", "AI HUB 官网改版", "release-bot"]):
        y = win_y0 + 62 + i * 52
        if i == 1:
            roundrect(d, [win_x0 + 28, y - 14, win_x0 + lw - 22, y + 26], 10, fill=MINT + (30,))
        d.ellipse([win_x0 + 36, y, win_x0 + 44, y + 8], fill=INK3 if i != 1 else MINT)
        d.text((win_x0 + 58, y - 10), lab, font=cjk(22, 500), fill=INK if i == 1 else INK3)

    # 中栏：对话气泡 + 计划卡
    mx0 = win_x0 + lw
    # 用户气泡（右）
    ub = "先给我方案，我确认你再动手改"
    f_ub = cjk(23, 500)
    ubw = text_w(d, ub, f_ub)
    roundrect(d, [mx0 + 560 - ubw - 30, win_y0 + 48, mx0 + 560, win_y0 + 96], 14, fill=MINT + (34,))
    d.text((mx0 + 560 - ubw - 15, win_y0 + 58), ub, font=f_ub, fill=(13, 92, 72))
    # 助手文字
    d.text((mx0 + 30, win_y0 + 60), "这是方案，批准后我开始执行。", font=cjk(23, 500), fill=INK2)
    # 工具行
    for i, (nm, sm) in enumerate([("搜索内容", "hero"), ("读取文件", "index.html"), ("读取文件", "style.css")]):
        y = win_y0 + 118 + i * 44
        roundrect(d, [mx0 + 30, y, mx0 + 420, y + 34], 9, fill=(255, 255, 255, 200), outline=(0, 0, 0, 14))
        d.text((mx0 + 44, y + 6), nm, font=cjk(20, 500), fill=INK2)
        d.text((mx0 + 160, y + 8), sm, font=mono(18), fill=INK3)
        d.text((mx0 + 380, y + 8), "✓", font=cjk(20, 600), fill=MINT)
    # 计划确认卡（紫边）——封面的视觉焦点
    py = win_y0 + 256
    roundrect(d, [mx0 + 300, py, mx0 + 560, py + 96], 14, fill=(255, 255, 255, 235), outline=LAV + (90,), width=2)
    d.text((mx0 + 318, py + 14), "计划待你确认", font=cjk(22, 600), fill=LAV)
    d.text((mx0 + 470, py + 16), "1/4", font=mono(19), fill=INK3)
    for i, done in enumerate([True, False, False, False]):
        cx = mx0 + 336 + i * 26
        if done:
            d.ellipse([cx, py + 56, cx + 16, py + 72], fill=MINT)
            d.text((cx + 3, py + 54), "✓", font=cjk(15, 700), fill=(255, 255, 255))
        else:
            d.ellipse([cx, py + 56, cx + 16, py + 72], outline=INK3, width=2)
    roundrect(d, [mx0 + 452, py + 54, mx0 + 548, py + 84], 10, fill=LAV)
    d.text((mx0 + 464, py + 58), "批准执行", font=cjk(19, 600), fill=(255, 255, 255))

    # 右栏：文件树
    rx0 = win_x0 + win_w - lw + 8
    d.rectangle([rx0 + 8, win_y0 + 26, win_x0 + win_w - 18, win_y0 + win_h - 26], fill=(255, 255, 255, 170))
    d.text((rx0 + 22, win_y0 + 42), "文件", font=cjk(21, 600), fill=INK)
    for i, nm in enumerate(["index.html", "assets", "legal.html", "research"]):
        y = win_y0 + 84 + i * 40
        if i == 0:
            roundrect(d, [rx0 + 14, y - 8, win_x0 + win_w - 26, y + 24], 8, fill=MINT + (26,))
        d.text((rx0 + 30, y), nm, font=mono(19), fill=INK if i == 0 else INK3)

    # 底部三卖点
    f_k = cjk(54, 700)
    f_l = cjk(26, 500)
    pts = [("先看方案", "动文件前你说了算"), ("全在本地", "数据不出你的电脑"), ("0 元可用", "21 个免 key 免费档")]
    cxs = [W / 2 - 520, W / 2, W / 2 + 520]
    for (k, l), cx in zip(pts, cxs):
        centered(d, cx, 1092, k, f_k, INK)
        centered(d, cx, 1150, l, f_l, INK3)

    img.convert("RGB").save(out, "PNG")
    return out

def cover_title_brand():
    return "巨天 agent"

if __name__ == "__main__":
    import sys
    t1 = sys.argv[1] if len(sys.argv) > 1 else "我不改文件，"
    t2 = sys.argv[2] if len(sys.argv) > 2 else "除非你先点头"
    sub = sys.argv[3] if len(sys.argv) > 3 else "一个住在你电脑里的编程智能体：先出方案，你批准，我再动手。"
    out = sys.argv[4] if len(sys.argv) > 4 else "cover.png"
    print(render((t1, t2), sub, out))
